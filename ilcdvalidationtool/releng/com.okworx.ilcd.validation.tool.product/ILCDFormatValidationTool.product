      <linux icon="/resources/icons/ILCDValidator-256_32bit.xpm"/>
      <macosx icon="/resources/icons/ILCDValidator.icns"/>
      <win useIco="false">
         <bmp
            winSmallHigh="/resources/icons/ILCDValidator-16_32bit.bmp"
