        </geography>
        <technology>
            <technologyDescriptionAndIncludedProcesses xml:lang="en">Rail transport via electric cargo train. Variable parameters (with default setting) are: utilisation and distance. Train production, end-of-life treatment of the train and upstream processes for electricity production (e.g. exploration and production of fuels, refinery, transport, combustion emissions of power plants) are not included in the data set.</technologyDescriptionAndIncludedProcesses>
            <technologicalApplicability xml:lang="en">Standard transport of bulk or volume goods with a payload of up to 726 tonnes for rail transport.</technologicalApplicability>
            <referenceToTechnologyFlowDiagrammOrPicture type="source data set" refObjectId="d0cf6d94-cd6a-4ffd-a1d8-742e9290cbdf" version="30.00.000" uri="../sources/d0cf6d94-cd6a-4ffd-a1d8-742e9290cbdf.xml">
                <common:shortDescription xml:lang="en">Transport_Rail_electric.jpg</common:shortDescription>
            </referenceToTechnologyFlowDiagrammOrPicture>
        </technology>
        <mathematicalRelations>
            <variableParameter name="distance">
                <meanValue>100.0</meanValue>
                <relativeStandardDeviation95In>0</relativeStandardDeviation95In>
                <comment xml:lang="en">[km] distance start - end, default = 100 km</comment>
            </variableParameter>
            <variableParameter name="gr_tonne_weight">
                <formula>2000</formula>
                <meanValue>2000.0</meanValue>
                <relativeStandardDeviation95In>0</relativeStandardDeviation95In>
                <comment xml:lang="en">[t] gross tonne weight of train, default = 2000 t</comment>
            </variableParameter>
            <variableParameter name="payload">
                <formula>71 / (71 + 43) * gr_tonne_weight</formula>
                <meanValue>726.190476190476</meanValue>
                <relativeStandardDeviation95In>0</relativeStandardDeviation95In>
                <comment xml:lang="en">[t] average wagon: empty weight: 43 t, payload capacity: 71 t</comment>
            </variableParameter>
            <variableParameter name="rel_nt_gt">
                <formula>utilisation / (utilisation + 43 / 71)</formula>
                <meanValue>0.514767932489452</meanValue>
                <relativeStandardDeviation95In>0</relativeStandardDeviation95In>
                <comment xml:lang="en">[net tonne/gross tonne]</comment>
            </variableParameter>
            <variableParameter name="spec_energy">
                <formula>(0.001) ^ 2 * (1 / rel_nt_gt) * (gr_tonne_weight &lt;= 2200 ? 1200 * gr_tonne_weight ^ -0.62 * distance : 1200 * 2200 ^ -0.52 * distance)</formula>
                <meanValue>0.00321787938404148</meanValue>
                <relativeStandardDeviation95In>0</relativeStandardDeviation95In>
                <comment xml:lang="en">[kWh/kg] energy consumption</comment>
            </variableParameter>
            <variableParameter name="utilisation">
                <meanValue>0.5</meanValue>
                <minimumValue>0.0</minimumValue>
                <maximumValue>1.0</maximumValue>
                <relativeStandardDeviation95In>0</relativeStandardDeviation95In>
                <comment xml:lang="en">[-] utilisation by mass, default average goods = 0.50 (bulk=0.76, volume goods=0.25)</comment>
            </variableParameter>
        </mathematicalRelations>
    </processInformation>
